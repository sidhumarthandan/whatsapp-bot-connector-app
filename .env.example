PORT=3000

# WAHA (WhatsApp HTTP API - Docker) Configuration
WAHA_BASE_URL=http://localhost:3001
WAHA_API_KEY=my_waha_secret_key
WAHA_SESSION=default

# Set to false if Make.com sends the reply via /webhook/whatsapp/send-group-message
AUTO_REPLY_FROM_NESTJS=true

# Meta Developer & WhatsApp API Credentials (Optional if using WAHA)
META_ACCESS_TOKEN=YOUR_ACCESS_TOKEN
META_APP_SECRET=YOUR_APP_SECRET
META_VERIFY_TOKEN=my_secret_verify_token_123
WHATSAPP_PHONE_NUMBER_ID=YOUR_PHONE_NUMBER_ID
WHATSAPP_BUSINESS_ACCOUNT_ID=YOUR_WABA_ID
META_API_VERSION=v21.0

# Make.com Integration (Webhook for downstream workflows)
MAKE_WEBHOOK_URL=
